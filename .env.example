# OmniController — copy to .env and fill in real values

# Bearer tokens for each endpoint (different values for each path)
AGENT_API_KEY=***
DEMO_API_KEY=***

# OmniRoute connection
OMNIROUTE_URL=http://omniroute:20128
OMNIROUTE_API_KEY=***

# Combo IDs in OmniRoute
AGENT_COMBO=personal
DEMO_COMBO=demo

# Rate limits (requests per minute)
AGENT_RATE_LIMIT=60
DEMO_RATE_LIMIT=10

# Optional HTTP timeout when calling OmniRoute
OMNIROUTE_TIMEOUT_SECONDS=30
